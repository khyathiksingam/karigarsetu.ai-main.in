# KARIGASETU AI - Environment Configuration Template
# Copy this file to .env and configure your keys.

# Vite frontend public Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# System Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default is zero-dependency SQLite for immediate local execution.
# For production PostgreSQL with pgvector, use:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/karigasetu_ai
DATABASE_URL=sqlite:///./karigasetu.db

# Security & JWT Authentication
JWT_SECRET=karigasetu_super_secret_jwt_key_2026_prototype
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini / Google AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Email OTP Providers
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=KARIGARSETU AI

# Telephony & OTP Providers (Set MOCK_PROVIDERS=true for offline judging)
MOCK_PROVIDERS=true
SMS_PROVIDER_KEY=twilio_or_msg91_api_key_here

# Object Storage (Local fallback or S3/Firebase bucket)
STORAGE_TYPE=local
STORAGE_BUCKET=karigasetu-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ONDC (Open Network for Digital Commerce) Sandbox Configuration
ONDC_ENVIRONMENT=staging
ONDC_SUBSCRIBER_ID=karigasetu.ai.bpp
ONDC_SIGNING_PRIVATE_KEY=
ONDC_GATEWAY_URL=https://staging.gateway.ondc.org
